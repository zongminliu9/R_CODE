# Downloaded structural data: 47 MB, fully regenerable with
#   python3 tbcb_tuba8/scripts/fetch_structures.py
tbcb_tuba8/data/pdb/*.cif
tbcb_tuba8/data/pdb/*.pdb
tbcb_tuba8/data/afdb/*.pdb

# Prepared / generated coordinates and trajectories
tbcb_tuba8/data/pdb/prep_*
*.dcd
*.xtc
*.trr
*.chk

__pycache__/
*.pyc
.ipynb_checkpoints/

# GPU package: generated systems and trajectories
tbcb_tuba8/gpu/systems/
tbcb_tuba8/gpu/out/
tbcb_tuba8/gpu/logs/
*.nc

# Package: the tables and docs are committed; these subdirectories duplicate
# repository content and are only assembled for the shipped archive
tbcb_tuba8/package/raw_results/
tbcb_tuba8/package/scripts/
tbcb_tuba8/package/gpu/
tbcb_tuba8/package/models/
tbcb_tuba8/package/sequences/
tbcb_tuba8/package/reports/
TBCB_TUBA8_complete_package.tar.gz

# MD trajectories and checkpoints: large binaries, regenerable from scripts/run_md.py
tbcb_tuba8/md/*.dcd
tbcb_tuba8/md/*.chk
tbcb_tuba8/data/models/prep/*_decomp.pdb
